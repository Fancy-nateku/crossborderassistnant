# Copy to backend/.env for local development. Never commit real values.
DATABASE_URL=postgresql://crossborder:crossborder_local@localhost:5433/crossborder
PORT=4000
# Exact browser origins, comma-separated, no wildcard.
ALLOWED_ORIGINS=http://localhost:3000
NODE_ENV=development
# Required when NODE_ENV=production.
SOURCE_MAX_AGE_DAYS=30
EXCHANGE_RATE_MAX_AGE_DAYS=30
# Must equal the frontend's AUTH_SECRET. Generate with: openssl rand -base64 32
AUTH_SECRET=
