{
  "name": "@crossborderassist/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate --schema ../prisma/schema.prisma",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "pretest:visual": "npm --prefix ../backend run build",
