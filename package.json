{
  "name": "crossborderassistnant",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "dev": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "start": "npm run start --workspace frontend",
    "start:backend": "npm run start --workspace backend",
    "lint": "npm run lint --workspace frontend",
    "test": "npm run test --workspace frontend",
    "test:backend": "npm run test --workspace backend",
    "test:visual": "npm run test:visual --workspace frontend",
    "test:visual:update": "npm run test:visual:update --workspace frontend",
    "seed:references": "tsx prisma/seed-reference-data.ts",
    "typecheck": "npm run typecheck --workspace frontend",
    "typecheck:backend": "npm run typecheck --workspace backend"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3",
    "tsx": "^4.20.6",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
